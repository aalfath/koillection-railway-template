# Based on upstream docker/Caddyfile (Koillection 1.8.6), plus /healthz and $PORT.
{
	{$CADDY_GLOBAL_OPTIONS}
	admin off
	auto_https off

	frankenphp {
		num_threads {$FRANKENPHP_THREADS_NUMBER:2}

		worker {
			file /app/public/public/index.php
			num {$FRANKENPHP_WORKERS_NUMBER:1}
		}
	}

	order php_server before file_server
	order php before file_server
}

{$FRANKENPHP_SERVER_NAME::8080} {
	root * public/
	encode zstd gzip

	header {
		Referrer-Policy same-origin
		Permissions-Policy interest-cohort=()
		Strict-Transport-Security "max-age=31536000; includeSubdomains; preload;"
		X-Content-Type-Options nosniff
		X-Frame-Options Deny
	}

	request_body {
		max_size {$UPLOAD_MAX_FILESIZE:100M}
	}

	# Health check for Railway: renders the login page, which also queries the database.
	handle /healthz {
		reverse_proxy 127.0.0.1:{$PORT:8080} {
			rewrite /
			header_up -Cookie
			header_down -Set-Cookie
		}
	}

	handle /uploads/* {
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server
	}

	handle {
		php_server
	}
}
